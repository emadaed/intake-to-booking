    {
      "parameters": {
        "jsCode": "const allowed = ['utm_source', 'utm_campaign', 'payer_type', 'created_at'];\nconst body = $input.first().json.body || {};\nconst lead = {};\nconst dropped = [];\n\nfor (const [key, value] of Object.entries(body)) {\n  if (allowed.includes(key)) {\n    lead[key] = typeof value === 'string' ? value.trim() : value;\n  } else {\n    dropped.push(key); // log the field NAME only, never the value\n  }\n}\n\nif (lead.utm_source) lead.utm_source = lead.utm_source.toLowerCase();\nif (lead.payer_type) lead.payer_type = lead.payer_type.toLowerCase();\n\nreturn [{ json: { lead, dropped } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        -400
      ],
